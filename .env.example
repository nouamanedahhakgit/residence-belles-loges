# ====================================================================
# VARIABLES D'ENVIRONNEMENT - RESIDENCE BELLES LOGES
# ====================================================================

# 1. URL de votre projet Supabase (obtenu dans Project Settings > API)
VITE_SUPABASE_URL=https://votre-id-projet.supabase.co

# 2. Clé publique Anonyme Supabase (Project Settings > API > Project API keys > anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_cle_anon_publique

# 3. Mode démo / secours (true par défaut si Supabase non renseigné)
# Si les clés Supabase ne sont pas encore configurées, l'application fonctionnera
# directement avec le jeu complet des données du fichier Excel en mémoire locale.
VITE_ENABLE_LOCAL_FALLBACK=true
